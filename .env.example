# =====================================================================
# Environment Variables Example (.env.example)
# Copy this file to .env and fill in your actual API Keys
# NOTE: Do NOT put model_name here. Per requirements, LLM_MODEL_NAME is 
# defined in source code (e.g. "Qwen/Qwen3-VL-8B-Instruct") & metadata.json.
# =====================================================================

# Hugging Face API Configuration
HF_TOKEN=hf_your_hugging_face_token_here
HUGGINGFACEHUB_API_TOKEN=hf_your_hugging_face_token_here
# HF_INFERENCE_ENDPOINT=https://router.huggingface.co/hf-inference/v1

# Paths & Directories Configuration
DATA_DIR=./data
INPUT_DIR=./input
OUTPUT_DIR=./output
LOGGING_DIR=./logging

# Application Logging Settings
LOG_LEVEL=INFO
